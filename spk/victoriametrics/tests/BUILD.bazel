sh_test(
    name = "resource_structure_test",
    size = "small",
    srcs = [":validate_resource_structure"],
    args = [
        "$(location :resource_expected)",
        "$(location :extract_resource)",
    ],
    data = [
        ":resource_expected",
        ":extract_resource",
    ],
)

write_file(
    name = "validate_resource_structure",
    out = "validate_resource_structure.sh",
    content = [
        "#!/bin/sh",
        "set -eu",
        "",
        "canonicalize_json() {",
        "  python3 -c 'import json, sys; from pathlib import Path; data = json.loads(Path(sys.argv[1]).read_text()); Path(sys.argv[2]).write_text(json.dumps(data, sort_keys=True, indent=2) + \"\\n\")' \"$1\" \"$2\"",
        "}",
        "",
        "expected=$1",
        "actual=$2",
        "",
        "normalized_expected=$(mktemp)",
        "normalized_actual=$(mktemp)",
        "trap 'rm -f \"$normalized_expected\" \"$normalized_actual\"' EXIT",
        "",
        'canonicalize_json "$expected" "$normalized_expected"',
        'canonicalize_json "$actual" "$normalized_actual"',
        'diff -u "$normalized_expected" "$normalized_actual"',
        "",
    ],
    is_executable = True,
)

write_file(
    name = "validate_avahi_script",
    out = "validate_avahi.sh",
    content = [
        "#!/bin/sh",
        "set -eu",
        "",
        'xmllint="$3"',
        'xml="$1"',
        'dtd="$2"',
        "",
        '"$xmllint" --noout --dtdvalid "$dtd" "$xml"',
        "",
    ],
    is_executable = True,
)

sh_test(
    name = "validate_avahi",
