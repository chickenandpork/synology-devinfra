write_file(
    name = "postinst_expected",
    out = "postinst.expected",
    content = [
        "#!/bin/sh",
        "set -eu",
        "",
        "PKGNAME=${SYNOPKG_PKGNAME:-victoriametrics}",
        "PKG_BASE=/var/packages/${PKGNAME}",
        "SHARE_DIR=${PKG_BASE}/shares/${PKGNAME}",
        "ETC_DIR=${SHARE_DIR}/etc",
        "DATA_DIR=${SHARE_DIR}/data",
        "LOG_DIR=${PKG_BASE}/var/log",
        "DEFAULT_DIR=${SYNOPKG_PKGDEST}/etc/default",
        "",
        "mkdir -p \"${ETC_DIR}\" \"${DATA_DIR}/victoria-metrics\" \"${DATA_DIR}/victoria-logs\" \"${DATA_DIR}/vmagent\" \"${LOG_DIR}\"",
        "",
        "copy_if_missing() {",
        "    if [ ! -f \"$2\" ] && [ -f \"$1\" ]; then",
        "        cp \"$1\" \"$2\"",
        "    fi",
        "}",
        "",
        "copy_if_missing \"${DEFAULT_DIR}/victoria-metrics.conf\" \"${ETC_DIR}/victoria-metrics.conf\"",
        "copy_if_missing \"${DEFAULT_DIR}/victoria-logs.conf\" \"${ETC_DIR}/victoria-logs.conf\"",
        "copy_if_missing \"${DEFAULT_DIR}/vmagent.conf\" \"${ETC_DIR}/vmagent.conf\"",
        "copy_if_missing \"${DEFAULT_DIR}/vmagent.yml\" \"${ETC_DIR}/vmagent.yml\"",
        "",
        "chmod 0644 \"${ETC_DIR}\"/victoria-metrics.conf \"${ETC_DIR}\"/victoria-logs.conf \"${ETC_DIR}\"/vmagent.conf \"${ETC_DIR}\"/vmagent.yml 2>/dev/null || true",
        "chmod 0755 \"${LOG_DIR}\" 2>/dev/null || true",
        "",
        "chown -R sc-victoriametrics \"${SHARE_DIR}\" \"${LOG_DIR}\" 2>/dev/null || true",
        "",
        "exit 0",
    ],
)

