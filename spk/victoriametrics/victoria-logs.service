[Unit]
Description=VictoriaLogs single-node

[Service]
User=sc-victoriametrics
Group=victoriametrics
EnvironmentFile=/var/packages/victoriametrics/target/etc/default/victoria-logs.conf
ExecStartPre=/bin/mkdir -p /var/packages/victoriametrics/shares/victoriametrics/data/victoria-logs
ExecStart=/bin/sh -c 'exec /var/packages/victoriametrics/target/bin/victoria-logs-prod -httpListenAddr="${VICTORIA_LOGS_HTTP_LISTEN_ADDR}" -storageDataPath="${VICTORIA_LOGS_STORAGE_DATA_PATH}" -retentionPeriod="${VICTORIA_LOGS_RETENTION_PERIOD}"'
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
