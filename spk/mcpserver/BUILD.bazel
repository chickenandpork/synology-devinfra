verify_archive_test(
    name = "spk_container_contains_package_tar",
    max_size = 50,
    must_contain = [
        "INFO",
        "conf/resource",
        "conf/systemd/pkg-user-mcpserver.service",
        "package.tgz",
        "scripts/postinst",
        "scripts/postuninst",
        "scripts/postupgrade",
        "scripts/preinst",
        "scripts/preuninst",
        "scripts/preupgrade",
        "scripts/start-stop-status",
    ],
    target = ":spk_archive",
)

verify_archive_test(
    name = "package_contains_binary",
    max_size = 50000,
    must_contain = [
        "bin/mcpserver",
    ],
    target = ":extract_package",
)

diff_test(
    name = "diff_service_unit_test",
    size = "small",
    file1 = ":service_unit_expected",
    file2 = ":extract_service_unit",
)

diff_test(
    name = "diff_postinst_test",
    size = "small",
    file1 = ":postinst_expected",
    file2 = ":extract_postinst",
)

diff_test(
    name = "diff_start_stop_status_test",
    size = "small",
    file1 = ":start_stop_status_expected",
    file2 = ":extract_start_stop_status",
)

write_file(
    name = "spk_platforms_expected",
    out = "spk-platforms.expected",
    content = [
        "mcpserver-ds1819+-7.1.spk",
        "",
    ],
)

diff_test(
    name = "diff_spk_platforms_basenames_test",
    size = "small",
    file1 = ":spk_platforms_expected",
    file2 = ":spk_platforms_basenames",
)
